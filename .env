# Copy this file to .env and fill in the values. Never commit .env.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campswapgo?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Optional: only allow sign-ups from your college email domain, e.g. gla.ac.in
ALLOWED_EMAIL_DOMAIN=

# Used once by: npm run seed:warden
WARDEN_EMAIL=warden@example.com
WARDEN_PASSWORD=change-me-please
